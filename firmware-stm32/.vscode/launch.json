{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/STM32H750VBT6.elf",
            "device": "STM32H750VB",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "openOCDPreConfigLaunchCommands": [
                "reset_config none"
            ],
            "preLaunchTask": "Build: Debug",
            "runToEntryPoint": "main"
        }
    ]
}